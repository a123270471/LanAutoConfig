<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>LanAutoConfigSlave</AssemblyName>
    <RootNamespace>LanAutoConfig</RootNamespace>
    <Version>1.0.0</Version>
    <Product>局域网配置工具（被控端）</Product>
    <AssemblyTitle>局域网配置工具-被控端</AssemblyTitle>
    <Description>局域网 PC 批量更名 &amp; IP 配置工具（被控端）</Description>
    <!-- 框架依赖：单文件 exe，但不内置 .NET 运行时（目标机需先装 .NET 6 桌面运行时 x64）。
         exe 名保持正式名，不加任何后缀。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 框架依赖发布里没有运行时可供压缩，开着只会拖慢启动 -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- 关闭 apphost 的 CET 兼容标记：.NET 9+ SDK 默认会打上该标记，
         而没打 CET 补丁的 Windows 上一启动就 "Unknown Hard Error"（.NET 6 SDK 会忽略此项，无副作用）。 -->
    <CETCompat>false</CETCompat>
    <!-- 程序图标（exe 资源 + 窗口/任务栏） -->
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <!-- 中文程序名：发布后把 exe 改名（程序集名保持 ASCII，避免工具链兼容问题） -->
    <PublishedExeName>局域网配置工具-被控端</PublishedExeName>
    <!-- 只保留英文资源，省掉其它语言的卫星程序集（约 -5MB） -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <Target Name="RenamePublishedExe" AfterTargets="Publish" Condition="Exists('$(PublishDir)$(AssemblyName).exe')">
    <Move SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)$(PublishedExeName).exe" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <!-- 硬件/资产信息采集：Win32_* WMI 查询（只在被控端用） -->
    <PackageReference Include="System.Management" Version="6.0.0" />
  </ItemGroup>

</Project>
